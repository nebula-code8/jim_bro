<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="JimBro.Uix.ClientHomeWindow"
        Title="ClientHomeWindow">
        
        <Border Grid.Row="0" Padding="15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                        <Button Content="Moj profil"
                                Click="ProfileButton_Click"
                                Padding="15,8"
                                FontSize="14"/>
                        <Button Content="Odjavi se"
                                Click="LogoutButton_Click"
                                Padding="15,8"
                                FontSize="14"/>
                        <Button Content="Posaljite zahtev treneru"
                                Click="RequestTrainerButton_Click"
                                Padding="15,8"
                                FontSize="14"/>
                </StackPanel>
        </Border>
        
</Window>
