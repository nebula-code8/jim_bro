<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        Height="400" Width="300"
        x:Class="JimBro.Uix.Views.RateExerciseWindow"
        Title="RateExerciseWindow">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="15" Margin="0,10,0,10">
            <StackPanel Spacing="10">
                <TextBox x:Name="RatingBox" Watermark="Ocena"></TextBox>
                <TextBox x:Name="CommentBox" Watermark="Komentar" MinLines="4"></TextBox>
            </StackPanel>
        </Border>
                
        <TextBlock Grid.Row="1" x:Name="ErrorMessageTextBlock" Foreground="Red" HorizontalAlignment="Center" IsVisible="False" TextWrapping="Wrap"/>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
            <Button Content="Oceni vezbu" Name="RateButton" Click="RateExerciseButton_Click" Width="100"></Button>
            <Button Content="Zatvori" Click="CloseButton_Click" Width="100"></Button>
        </StackPanel>
    </Grid>
</Window>
