<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
        Width="400" Height="500"
        WindowStartupLocation="CenterScreen"
        x:Class="JimBro.Uix.Views.LogInForm"
        Title="LogInForm">
        
        <Grid Margin="40">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Email:" FontSize="14" Margin="0,0,0,5"/>
                <TextBox Grid.Row="0" x:Name="EmailTextBox" FontSize="14" Padding="5" Margin="0,30,0,0"/>

                <TextBlock Grid.Row="2" Text="Lozinka:" FontSize="14" Margin="0,0,0,5"/>
                <TextBox Grid.Row="2" x:Name="PasswordTextBox" FontSize="14" Padding="5" Margin="0,30,0,0"
                         PasswordChar="*"/>

                <TextBlock Grid.Row="4" x:Name="ErrorMessageTextBlock"
                           Foreground="Red" FontSize="12"
                           TextWrapping="Wrap" IsVisible="False"/>

                <Button Grid.Row="6" Content="Prijavi se"
                        FontSize="14" Padding="10"  Width="100"
                        Click="LoginButton_Click" Margin="0,20,0,0"/>
                
                <Button Grid.Row="7" Content="Registruj se"
                        FontSize="14" Padding="10" Width="100"
                        Click="RegisterButton_Click" Margin="0,10,0,0"/>
                
                <Button Grid.Row="8" Content="Pregled vezbi"
                        FontSize="14" Padding="10" Width="130"
                        Margin="0,80,0,0"/>
        </Grid>
</Window>
